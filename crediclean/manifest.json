{
  "manifest_version": 3,
  "name": "CrediClean",
  "version": "0.1.0",
  "description": "Inspect and remove supported Content Credentials from images in ChatGPT, without leaving the page.",
  "minimum_chrome_version": "111",

  "permissions": ["storage"],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CrediClean",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },

  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/content/image-detector.js",
        "src/content/overlay.js",
        "src/content/button-manager.js",
        "src/content/content.css",
        "src/processing/image-loader.js",
        "src/processing/metadata-inspector.js",
        "src/processing/credential-processor.js",
        "src/processing/download-manager.js",
        "src/formats/detect.js",
        "src/formats/png.js",
        "src/formats/jpeg.js",
        "src/formats/webp.js",
        "src/formats/jumbf.js",
        "src/shared/constants.js",
        "src/shared/messages.js",
        "src/shared/settings.js"
      ],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
